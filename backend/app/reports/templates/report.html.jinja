<div class="report-content">
    <h3>1. Business Overview</h3>
    <p><strong>Business Category:</strong> {{ category.name if category else 'Not Selected' }}</p>
    <p><strong>Target Location:</strong> {{ location.district if location else 'Unknown' }}{% if location and location.state %}, {{ location.state }}{% endif %}</p>
    <p><strong>User Margin Capital:</strong> ₹{{ "{:,.2f}".format(session.margin_capital) if session and session.margin_capital else '0.00' }}</p>

    {% if loan %}
    <h3 style="margin-top: 2rem;">2. Capital Requirements & Proposed Financing</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <thead>
            <tr style="border-bottom: 2px solid #ea580c; text-align: left;">
                <th style="padding: 0.75rem;">Metric</th>
                <th style="padding: 0.75rem; text-align: right;">Amount (₹)</th>
            </tr>
        </thead>
        <tbody>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Total Estimated Project Cost</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">{{ "{:,.2f}".format(loan.project_cost) }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Beneficiary Contribution (Margin)</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">{{ "{:,.2f}".format(loan.beneficiary_contribution) }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Required Term Loan Amount</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold; color: #ea580c;">{{ "{:,.2f}".format(loan.loan_amount) }}</td>
            </tr>
        </tbody>
    </table>
    {% endif %}

    {% if projection %}
    <h3 style="margin-top: 2rem;">3. Financial Projections & Feasibility (Year 1)</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <thead>
            <tr style="border-bottom: 2px solid #ea580c; text-align: left;">
                <th style="padding: 0.75rem;">Financial Indicator</th>
                <th style="padding: 0.75rem; text-align: right;">Projected Value</th>
            </tr>
        </thead>
        <tbody>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Estimated Monthly Revenue</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">₹{{ "{:,.2f}".format(projection.monthly_revenue) }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Estimated Monthly Net Profit</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">₹{{ "{:,.2f}".format(projection.net_profit) }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Estimated Monthly EMI</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">₹{{ "{:,.2f}".format(projection.monthly_emi) if projection.monthly_emi else 'N/A' }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Return on Investment (ROI)</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold; color: #059669;">{{ "{:,.1f}".format(projection.roi) }}%</td>
            </tr>
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 0.75rem;">Debt Service Coverage Ratio (DSCR)</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">{{ "{:,.2f}".format(projection.dscr) }}</td>
            </tr>
            <tr>
                <td style="padding: 0.75rem;">Break-Even Point (Units/Month)</td>
                <td style="padding: 0.75rem; text-align: right; font-weight: bold;">{{ "{:,.0f}".format(projection.break_even_units) }}</td>
            </tr>
        </tbody>
    </table>
    
    <div style="margin-top: 1.5rem; padding: 1rem; background-color: #f8fafc; border-left: 4px solid #ea580c; border-radius: 4px;">
        <p style="margin: 0; font-size: 0.95rem; color: #334155;">
            <strong>Analyst Note:</strong> A DSCR of {{ "{:,.2f}".format(projection.dscr) }} indicates that the business generates sufficient cash flow to cover its debt obligations. An ROI of {{ "{:,.1f}".format(projection.roi) }}% represents a healthy return on the initial capital outlay.
        </p>
    </div>
    {% endif %}
</div>
